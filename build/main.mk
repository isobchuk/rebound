include $(ROOT)build/log.mk

export CONFIGURATION RESULT_FOLDER_NAME BIN_FOLDER_NAME LIB_FOLDER_NAME OBJ_FOLDER_NAME WARNINGS WARNINGS_CPP WARNINGS_NO FLAGS CFLAGS CXXFLAGS LDFLAGS LIBS INCLUDES

LIB_ROOT = $(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(LIB_FOLDER_NAME)
SUBLIBS  = $(shell dir /s /b "$(LIB_ROOT)"\*.lib)

.PHONY: all clean $(DIRS)

all:  $(DIRS) $(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME) $(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME)/$(TARGET).exe
	$(LOG_SIZE)
	$(SIZE) $(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME)/$(TARGET).exe

$(DIRS):
	$(MAKE) -C $@ ROOT=../$(ROOT) PRE_DIR= $(MAKECMDGOALS) CC=$(CC) CXX=$(CXX) AR=$(AR)

$(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME)/$(TARGET).exe: $(DIRS) $(SUBLIBS)
	$(LOG_LD)
	$(CXX) $(FLAGS) $(SUBLIBS) $(LDFLAGS) $(LIBS) -o $(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME)/$(TARGET).exe

$(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME) :
	$(shell mkdir "$(ROOT)$(RESULT_FOLDER_NAME)/$(CONFIGURATION)/$(BIN_FOLDER_NAME)")

clean: $(DIRS)
	$(shell rmdir /s /q "$(ROOT)$(RESULT_FOLDER_NAME)")